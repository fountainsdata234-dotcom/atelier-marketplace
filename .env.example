VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_publishable_key
# Local only. Leave unset on Vercel; its /api rewrite forwards to Render.
VITE_API_URL=http://localhost:8787

# Server-only credentials. Never expose the service role key to the browser.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_secret_key
# Read-only Supabase Management API access for admin usage telemetry.
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_ACCESS_TOKEN=your_scoped_management_token
# Server-only Lumina conversation model key. Never expose this as VITE_GEMINI_API_KEY.
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TOKEN_LIMIT=1000000

# Lumina owner identity shown when users ask who runs the marketplace.
BOSS_NAME=Your name
BOSS_EMAIL=your-email@example.com
BOSS_PHONE=your phone number

# Contact-form email delivery. CONTACT_FROM_EMAIL must be a sender verified by Resend.
RESEND_API_KEY=your_resend_api_key
CONTACT_FROM_EMAIL=FABSATTIRE <contact@your-verified-domain.com>

# Optional server-only Cloudinary credentials for verified account usage telemetry.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Backend runtime settings
PORT=8787
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
