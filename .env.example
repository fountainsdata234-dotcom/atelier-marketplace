VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_publishable_key
# Local only. Leave unset on Vercel; its /api rewrite forwards to Render.
VITE_API_URL=http://localhost:8787

# Server-only credentials. Never expose the service role key to the browser.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_secret_key
# Server-only Lumina conversation model key. Never expose this as VITE_GEMINI_API_KEY.
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# Backend runtime settings
PORT=8787
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
