{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js --port=3000 --host=0.0.0.0",
    "build": "node ./node_modules/vite/bin/vite.js build",
    "preview": "node ./node_modules/vite/bin/vite.js preview",
    "server": "node --env-file-if-exists=.env.local ./node_modules/tsx/dist/cli.mjs server/index.ts",
    "start": "node --env-file-if-exists=.env.local ./node_modules/tsx/dist/cli.mjs server/index.ts",
    "migrate:firebase-to-supabase": "node --env-file-if-exists=.env.local scripts/migrate-firebase-to-supabase.mjs",
    "server:check": "node ./node_modules/typescript/bin/tsc --noEmit -p tsconfig.server.json",
    "android:twa:update": "node ./node_modules/@bubblewrap/cli/bin/bubblewrap.js update --manifest=twa-manifest.json --directory=android --skipVersionUpgrade",
    "android:twa:build": "node ./node_modules/@bubblewrap/cli/bin/bubblewrap.js build --manifest=twa-manifest.json --directory=android",
    "android:twa:fingerprint:add": "node ./node_modules/@bubblewrap/cli/bin/bubblewrap.js fingerprint add --manifest=twa-manifest.json --name=Fabsattire-upload-key --output=public/.well-known/assetlinks.json",
    "android:twa:assetlinks": "node ./node_modules/@bubblewrap/cli/bin/bubblewrap.js fingerprint generateAssetLinks --manifest=twa-manifest.json --output=public/.well-known/assetlinks.json",
    "clean": "rm -rf dist server.js",
    "lint": "node ./node_modules/typescript/bin/tsc --noEmit",
    "postinstall": "node scripts/patch-three-fbx-loader.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@supabase/supabase-js": "^2.117.2",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.6",
    "country-state-city": "^3.2.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase-admin": "^14.3.0",
    "framer-motion": "^13.2.0",
    "libphonenumber-js": "^1.13.12",
    "lucide-react": "^0.546.0",
    "motion": "12.23.24",
    "multer": "^2.3.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "sharp": "^0.34.3",
    "three": "^0.186.0",
    "vite": "^6.2.3",
    "zod": "^4.6.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@bubblewrap/cli": "^1.27.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^5.0.0"
  }
}
