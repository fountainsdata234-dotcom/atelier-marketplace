rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && (request.auth.token.email == 'fountainsdata234@gmail.com' || request.auth.token.admin == true || request.auth.token.role == 'admin'); }

    match /profiles/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if signedIn() && request.auth.uid == userId && request.resource.data.id == userId && (request.resource.data.role != 'admin' || isAdmin());
      allow update: if signedIn() && request.resource.data.id == userId && (isAdmin() || (request.auth.uid == userId && request.resource.data.role == resource.data.role));
      allow delete: if isAdmin();
    }

    match /posts/{postId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.authorId == request.auth.uid && get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role in ['tailor', 'fabric_seller'];
      allow update, delete: if signedIn() && (resource.data.authorId == request.auth.uid || isAdmin());

      match /ratings/{userId} {
        allow read: if true;
        allow create, update: if signedIn() && request.auth.uid == userId;
        allow delete: if signedIn() && (request.auth.uid == userId || isAdmin());
      }

      match /likes/{userId} {
        allow read: if true;
        allow create, delete: if signedIn() && request.auth.uid == userId;
      }

      match /saves/{userId} {
        allow read: if true;
        allow create, delete: if signedIn() && request.auth.uid == userId;
      }
    }

    match /messages/{messageId} {
      allow read: if signedIn() && (resource.data.senderId == request.auth.uid || resource.data.recipientId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.senderId == request.auth.uid;
      allow update: if signedIn() && resource.data.recipientId == request.auth.uid;
      allow delete: if false;
    }

    match /fabricRequests/{requestId} {
      allow create: if signedIn() && request.resource.data.buyerId == request.auth.uid;
      allow read: if signedIn() && (resource.data.buyerId == request.auth.uid || resource.data.sellerId == request.auth.uid || isAdmin());
      allow update: if signedIn() && (resource.data.buyerId == request.auth.uid || resource.data.sellerId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }
  }
}
