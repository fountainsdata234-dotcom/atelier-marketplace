{
  "rewrites": [
    {
      "source": "/assets/(.*)",
      "destination": "/assets/$1"
    },
    {
      "source": "/textures/(.*)",
      "destination": "/textures/$1"
    },
    {
      "source": "/3d/(.*)",
      "destination": "/3d/$1"
    },
    {
      "source": "/manifest.webmanifest",
      "destination": "/manifest.webmanifest"
    },
    {
      "source": "/sw.js",
      "destination": "/sw.js"
    },
    {
      "source": "/marketplace",
      "destination": "/index.html"
    },
    {
      "source": "/artisan",
      "destination": "/index.html"
    },
    {
      "source": "/about",
      "destination": "/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/index.html"
    },
    {
      "source": "/terms",
      "destination": "/index.html"
    },
    {
      "source": "/contact",
      "destination": "/index.html"
    },
    {
      "source": "/@:handle/post/:postId",
      "destination": "/index.html"
    },
    {
      "source": "/@:handle",
      "destination": "/index.html"
    },
    {
      "source": "/api/(.*)",
      "destination": "https://atelier-marketplace.onrender.com/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}